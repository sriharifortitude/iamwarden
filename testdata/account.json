{
  "UserDetailList": [
    {
      "UserName": "dana",
      "Arn": "arn:aws:iam::111122223333:user/dana",
      "GroupList": ["developers"],
      "UserPolicyList": [],
      "AttachedManagedPolicies": []
    },
    {
      "UserName": "auditor",
      "Arn": "arn:aws:iam::111122223333:user/auditor",
      "GroupList": [],
      "UserPolicyList": [],
      "AttachedManagedPolicies": [
        {"PolicyName": "SecurityAudit", "PolicyArn": "arn:aws:iam::aws:policy/SecurityAudit"}
      ]
    }
  ],
  "GroupDetailList": [
    {
      "GroupName": "developers",
      "Arn": "arn:aws:iam::111122223333:group/developers",
      "GroupPolicyList": [
        {
          "PolicyName": "deploy-functions",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {"Sid": "Functions", "Effect": "Allow", "Action": ["lambda:UpdateFunctionCode", "lambda:GetFunction"], "Resource": "*"}
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    }
  ],
  "RoleDetailList": [
    {
      "RoleName": "github-deploy",
      "Arn": "arn:aws:iam::111122223333:role/github-deploy",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {"Federated": "arn:aws:iam::111122223333:oidc-provider/token.actions.githubusercontent.com"},
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {"StringEquals": {"token.actions.githubusercontent.com:aud": "sts.amazonaws.com"}}
          }
        ]
      },
      "RolePolicyList": [],
      "AttachedManagedPolicies": [
        {"PolicyName": "ci-runner", "PolicyArn": "arn:aws:iam::111122223333:policy/ci-runner"}
      ]
    },
    {
      "RoleName": "batch-worker",
      "Arn": "arn:aws:iam::111122223333:role/batch-worker",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {"Effect": "Allow", "Principal": {"Service": "ecs-tasks.amazonaws.com"}, "Action": "sts:AssumeRole"}
        ]
      },
      "RolePolicyList": [
        {
          "PolicyName": "read-inputs",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {"Effect": "Allow", "Action": ["s3:GetObject", "s3:ListBucket"], "Resource": ["arn:aws:s3:::batch-inputs", "arn:aws:s3:::batch-inputs/*"]}
            ]
          }
        }
      ],
      "AttachedManagedPolicies": []
    }
  ],
  "Policies": [
    {
      "PolicyName": "ci-runner",
      "Arn": "arn:aws:iam::111122223333:policy/ci-runner",
      "DefaultVersionId": "v3",
      "PolicyVersionList": [
        {
          "VersionId": "v3",
          "IsDefaultVersion": true,
          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {"Sid": "Launch", "Effect": "Allow", "Action": ["ec2:RunInstances", "ec2:Describe*"], "Resource": "*"},
              {"Sid": "PassAnyRole", "Effect": "Allow", "Action": "iam:PassRole", "Resource": "*"},
              {"Sid": "Artifacts", "Effect": "Allow", "Action": "s3:*", "Resource": "*"}
            ]
          }
        }
      ]
    },
    {
      "PolicyName": "SecurityAudit",
      "Arn": "arn:aws:iam::aws:policy/SecurityAudit",
      "DefaultVersionId": "v1",
      "PolicyVersionList": [
        {
          "VersionId": "v1",
          "IsDefaultVersion": true,
          "Document": {
            "Version": "2012-10-17",
            "Statement": [
              {"Effect": "Allow", "Action": ["iam:Get*", "iam:List*", "ec2:Describe*", "s3:GetBucketPolicy"], "Resource": "*"}
            ]
          }
        }
      ]
    }
  ]
}
